{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "CoreDatabase": "Server=.;Database=EduAssist_Core;Trusted_Connection=True;TrustServerCertificate=True;",
    "AuthDatabase": "Server=.;Database=EduAssist_Auth;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "SecretKey": "REPLACE_WITH_YOUR_SECRET_KEY_MINIMUM_32_CHARACTERS",
    "Issuer": "EduAssist-AI",
    "Audience": "EduAssist-AI",
    "ExpirationInMinutes": 60
  },

  "OpenAI": {
    "ApiKey": "REPLACE_WITH_YOUR_OPENAI_KEY",
    "Model": "gpt-3.5-turbo",
    "MaxTokens": 1000
  },

  "RateLimit": {
    "MaxRequestsPerDay": 20
  }
}
